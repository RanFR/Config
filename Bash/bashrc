# Only run for interactive shells
[[ $- != *i* ]] && return

# Load modular config from ~/.config/bash/NN-*
# All loader-internal state lives inside this function and is freed afterwards.
__load_bash_config() {
	local dir="$HOME/.config/bash"
	local file

	if [[ ! -d "$dir" ]]; then
		printf 'ERROR: Configuration directory not found: %s\n' "$dir" >&2
		PS1='\u@\h:\w\$ '
		return 1
	fi

	for file in "$dir"/[0-9][0-9]-*; do
		[[ -f "$file" && -r "$file" ]] && source "$file"
	done

	return 0
}
__load_bash_config
unset -f __load_bash_config
